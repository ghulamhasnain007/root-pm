# ─────────────────────────────────────────────────────────────
# Project Root — shared environment variables
# Copy to .env and fill in your values
# Each sub-project also has its own .env.example
# ─────────────────────────────────────────────────────────────

# ── Discord ─────────────────────────────────────────────────
# Voice bot (scrum-master-ai) — reads DISCORD_TOKEN
DISCORD_TOKEN=your_discord_voice_bot_token

# Text bot (agent-bridge) — reads DISCORD_BOT_TOKEN
DISCORD_BOT_TOKEN=your_discord_text_bot_token
DISCORD_TRIGGER_ROLE=FYP

# ── Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AGENT_MODEL=gemini-2.5-flash
CLASSIFIER_MODEL=gemini-2.5-flash

# ── MongoDB (voice bot) ───────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scrum-master-ai

# ── Taiga (agent-bridge) ──────────────────────────────────────
# These are used by BOTH systems:
#   - agent-bridge text bot mirrors Taiga task created/updated/closed.
#   - scrum-master-ai voice bot switches to TaigaTaskStore (direct Taiga
#     access: create/close/update/assign/list + sprint/member queries) when
#     all four are set.
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=your_taiga_username
TAIGA_PASS=your_taiga_password
TAIGA_PROJECT_SLUG=your-project-slug

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=scrum-master-ai
KAFKA_GROUP_ID=agent-bridge-consumer
KAFKA_AUTO_OFFSET_RESET=latest
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=your_api_key
# KAFKA_SASL_PASSWORD=your_api_secret

# ── Voice→Text channel mapping (for meeting memory injection) ─
# voice_channel_discord_id:text_channel_discord_id
VOICE_TO_TEXT_CHANNEL_MAP=1234567890123456789:9876543210987654321
INJECT_LIVE_TRANSCRIPT=false

# ── Agent settings ────────────────────────────────────────────
MAX_ITERATIONS=8
CONTEXT_CACHE_TTL=60
# Hard budget for meeting-context + conversation history injected into the
# system prompt (previously loaded but not enforced — now actually applied
# via agent/context.py's ContextAssembler).
MEMORY_MAX_TOKENS=2000

# ── Redis (short-term memory) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MongoDB (long-term memory) ────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=agent_bridge

# ── Semantic memory search (optional) ──────────────────────────
# Uses the same GEMINI_API_KEY above. When unset/unavailable, memory search
# silently falls back to keyword/regex matching — this is purely additive.
EMBEDDING_MODEL=models/text-embedding-004
MEMORY_CHUNK_TOKENS=400
MEMORY_CHUNK_OVERLAP=60
MEMORY_TOP_K=5

# ── /api/memory/* auth (optional, recommended for anything beyond local dev) ─
# These endpoints expose meeting transcripts and project facts. Set this to
# require an `X-API-Key` header on every request; leave unset to keep the
# previous (dev-only) unauthenticated behavior.
MEMORY_API_KEY=

# ── Org tool credentials via auth-service (optional — multi-tenancy Phase 3) ─
# By default scrum-master-ai stores admin-entered tool credentials (Discord
# bot token, etc.) itself, same as always (INTEGRATIONS_STORAGE_DRIVER
# below). Set CREDENTIALS_STORE_DRIVER=auth-service to instead fetch them
# from auth-service — once set, credentials for this app's tools are
# configured on the org's Tools page in `client/`, not in this app's own
# settings routes. See scrum-master-ai/backend/src/integrations/store/
# AuthServiceCredentialsStore.ts.
INTEGRATIONS_STORAGE_DRIVER=mongo
CREDENTIALS_STORE_DRIVER=
AUTH_SERVICE_URL=http://localhost:4000
AUTH_SERVICE_INTERNAL_KEY=
AUTH_SERVICE_CACHE_TTL_MS=30000
# Which org's Discord credentials power the ambient assistant's single
# boot-time instance — see scrum-master-ai's README for the single-org
# bootstrap constraint this works around.
AMBIENT_BOOTSTRAP_ORG_ID=default

# ── Client (unified dashboard) ──────────────────────────────────
# Base URL the client app uses for auth-service calls. Leave unset in
# normal dev/Docker use — the client proxies /auth, /orgs, /.well-known
# to auth-service automatically (see client/vite.config.ts, client/nginx.conf),
# same as it already does for config-api and voice-bot. Only set this if
# running the client against an auth-service that ISN'T reachable through
# that proxy (e.g. a separately-hosted auth-service).
VITE_AUTH_API=
