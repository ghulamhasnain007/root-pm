# ─────────────────────────────────────────────────────────────
# Project Root — shared environment variables
# Copy to .env and fill in your values
# Each sub-project also has its own .env.example
# ─────────────────────────────────────────────────────────────

# ── Discord ─────────────────────────────────────────────────
# Voice bot (scrum-master-ai) — reads DISCORD_TOKEN
DISCORD_TOKEN=your_discord_voice_bot_token

# Text bot (agent-bridge) — reads DISCORD_BOT_TOKEN
DISCORD_BOT_TOKEN=your_discord_text_bot_token
DISCORD_TRIGGER_ROLE=FYP

# ── Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AGENT_MODEL=gemini-2.5-flash
CLASSIFIER_MODEL=gemini-2.5-flash

# ── MongoDB (voice bot) ───────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scrum-master-ai

# ── Taiga (agent-bridge) ──────────────────────────────────────
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=your_taiga_username
TAIGA_PASS=your_taiga_password
TAIGA_PROJECT_SLUG=your-project-slug

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=scrum-master-ai
KAFKA_GROUP_ID=agent-bridge-consumer
KAFKA_AUTO_OFFSET_RESET=latest
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=your_api_key
# KAFKA_SASL_PASSWORD=your_api_secret

# ── Voice→Text channel mapping (for meeting memory injection) ─
# voice_channel_discord_id:text_channel_discord_id
VOICE_TO_TEXT_CHANNEL_MAP=1234567890123456789:9876543210987654321
INJECT_LIVE_TRANSCRIPT=false

# ── Agent settings ────────────────────────────────────────────
MAX_ITERATIONS=8
CONTEXT_CACHE_TTL=60
MEMORY_MAX_TOKENS=2000
