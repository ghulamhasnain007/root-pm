# ── Server ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173

# ── Gemini Live API (required) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ── Auth (multi-org) ────────────────────────────────────────────
# Unset by default — falls back to a single fixed org ("default") with no
# authentication, so this service still runs standalone without
# auth-service for local dev. Set AUTH_SERVICE_URL to require real login
# and scope every request to the caller's actual org. See
# src/auth/requireAuth.ts.
AUTH_SERVICE_URL=
# Shared secret for auth-service's internal credential-fetch endpoint —
# must match auth-service's own INTERNAL_SERVICE_KEY exactly.
AUTH_SERVICE_INTERNAL_KEY=
AUTH_SERVICE_CACHE_TTL_MS=30000

# Which org's Discord credentials power the ambient assistant's single
# boot-time instance (see src/integrations/discord/ambient/setupAmbient.ts —
# this is a known single-org bootstrap constraint, not yet per-org).
AMBIENT_BOOTSTRAP_ORG_ID=default

# ── MongoDB (schedules, ambient config, OAuth tokens, task history) ────
MONGODB_URI=mongodb://localhost:27017/scrum-master-ai

# ── Kafka (task/meeting events → agent-bridge) ─────────────────
KAFKA_BROKERS=
KAFKA_CLIENT_ID=scrum-master-ai
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Storage drivers for integrations (both default to mongo) ──────────
# credentials: mongo | file | auth-service (see AuthServiceCredentialsStore)
# connections (OAuth tokens): mongo | file — always local, not auth-service,
# since these are per-connection runtime tokens, not admin-entered config.
INTEGRATIONS_STORAGE_DRIVER=mongo
CREDENTIALS_STORE_DRIVER=
INTEGRATIONS_DATA_DIR=./data
INTEGRATIONS_BASE_URL=http://localhost:3001

# ── Legacy single-org fallback credentials ─────────────────────────────
# Only used when AUTH_SERVICE_URL/CREDENTIALS_STORE_DRIVER=auth-service
# aren't set, and only as a bootstrap convenience for local dev — the
# supported path for configuring Discord/Taiga credentials is the org's
# Tools page in client/ once auth-service is wired up.
DISCORD_BOT_TOKEN=
TAIGA_URL=
TAIGA_USER=
TAIGA_PASS=
TAIGA_PROJECT_SLUG=
