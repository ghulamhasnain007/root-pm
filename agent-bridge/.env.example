# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_TRIGGER_ROLE=FYP

# Taiga
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=your_taiga_username
TAIGA_PASS=your_taiga_password

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Agent settings (optional overrides)
AGENT_MODEL=gemini-1.5-pro
CLASSIFIER_MODEL=gemini-1.5-flash
MAX_ITERATIONS=8
CONTEXT_CACHE_TTL=60
MEMORY_MAX_TOKENS=2000

# Paths
CONFIG_PATH=backend/data/config.json
