FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

COPY agent-bridge/requirements.txt /tmp/agent-requirements.txt
RUN pip install --no-cache-dir -r /tmp/agent-requirements.txt kafka-python>=2.0.0

COPY agent-bridge/ ./agent-bridge/
COPY kafka-bridge/python-consumer/ ./kafka-bridge/python-consumer/

WORKDIR /app/kafka-bridge/python-consumer
ENV AGENT_BRIDGE_ROOT=/app/agent-bridge
CMD ["python", "main.py"]
