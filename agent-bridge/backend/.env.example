APP_TITLE=Agent Bridge API
APP_VERSION=0.1.0
CONFIG_PATH=data/config.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

COMM_PLATFORM=discord
PM_PLATFORM=taiga

DISCORD_BOT_TOKEN=
DISCORD_TRIGGER_ROLE=FYP

TAIGA_URL=
TAIGA_USER=
TAIGA_PASS=

GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
CLASSIFIER_MODEL=gemini-2.5-flash

MAX_ITERATIONS=8
CONTEXT_CACHE_TTL=60
MEMORY_MAX_TOKENS=2000
# ── Semantic memory search (optional, falls back to keyword search) ────────
EMBEDDING_MODEL=models/text-embedding-004
MEMORY_CHUNK_TOKENS=400
MEMORY_CHUNK_OVERLAP=60
MEMORY_TOP_K=5

# ── /api/memory/* auth (optional — recommended beyond local dev) ───────────
MEMORY_API_KEY=

# ── Org credentials via auth-service (optional — multi-tenancy Phase 4) ────
# Off by default (fully backward compatible — Discord/Taiga credentials keep
# coming from config.json/env vars as always). Set AUTH_SERVICE_URL to
# overlay credentials fetched from auth-service on top of the loaded config
# before startup validation runs. See core/auth_service_client.py.
AUTH_SERVICE_URL=
AUTH_SERVICE_INTERNAL_KEY=
AUTH_SERVICE_CACHE_TTL_SECONDS=30
ORG_ID=default
