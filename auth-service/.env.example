# ── Server ──────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

# ── Storage ─────────────────────────────────────────────────────
# 'memory' has no external dependencies but does NOT persist across
# restarts — dev/test only. Use 'mongo' for anything real.
STORAGE=mongo
MONGO_URI=mongodb://localhost:27017/auth-service

# Same idea for sessions (refresh tokens) — 'memory' won't share sessions
# across multiple auth-service instances. Use 'redis' for anything real.
SESSION_STORE=redis
REDIS_URL=redis://localhost:6379/1

# ── JWT signing (RS256) ─────────────────────────────────────────
# If unset, an ephemeral key pair is generated at boot — every restart
# invalidates all active sessions. Generate a persistent pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# then paste the PEM contents (including header/footer lines) below.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_HOURS=24
INVITE_TTL_DAYS=7

# ── Tool credential encryption (Discord bot tokens, Taiga passwords, etc.) ──
# AES-256-GCM key, base64-encoded 32 bytes. If unset, an ephemeral key is
# generated at boot — every restart makes previously-stored credentials
# undecryptable. Generate a persistent one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOOL_CREDENTIAL_ENCRYPTION_KEY=

# ── Internal service-to-service auth ─────────────────────────────────────
# Shared secret agent-bridge/scrum-master-ai send as X-Internal-Key to fetch
# decrypted tool credentials. If unset, an ephemeral one is generated and
# logged once at boot (fine for single-process local dev where you can copy
# it from the log; NOT for production — set explicitly and share it with
# those services out of band).
INTERNAL_SERVICE_KEY=

# ── Migration seeding (existing single-tenant deployment → one seeded org) ──
# See src/migration/seedDefaultOrg.ts. Off by default; idempotent when on.
SEED_DEFAULT_ORG=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
SEED_ORG_NAME=Default Organization
# Legacy single-tenant credentials to migrate into the seeded org's tool
# configs — same env var meanings agent-bridge/scrum-master-ai already use.
SEED_TAIGA_URL=
SEED_TAIGA_USER=
SEED_TAIGA_PASS=
SEED_DISCORD_BOT_TOKEN=

# ── Email ───────────────────────────────────────────────────────
# 'console' logs verification/invite emails instead of sending them — fine
# for dev, not for anything a real user needs to receive. Use 'smtp' and
# fill in the fields below for production.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Root-PM <no-reply@your-domain.example>
